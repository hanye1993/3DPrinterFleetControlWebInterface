{
  "identifier": "device_model_card",
  "name": "设备卡片机型显示",
  "version": "1.0.0",
  "description": "在设备列表卡片上显示机型；未设置时显示「未知」。",
  "copyright": "hanye",
  "available": true,
  "hooks": ["register"],
  "vars": [
    {
      "key": "show_on_cards",
      "title": "设备卡片显示机型",
      "type": "boolean",
      "value": "1"
    },
    {
      "key": "place",
      "title": "显示位置",
      "type": "select",
      "value": "after_name",
      "options": [
        { "label": "名称旁徽章", "value": "after_name" },
        { "label": "卡片扩展区", "value": "extra" },
        { "label": "两处都显示", "value": "both" }
      ]
    },
    {
      "key": "poll_sec",
      "title": "机型缓存刷新间隔（秒）",
      "type": "number",
      "value": "15"
    }
  ],
  "clientJs": ["client.js"],
  "themeCss": "theme.css",
  "installFile": "install.js",
  "uninstallFile": "uninstall.js",
  "mainFile": "main.js"
}
