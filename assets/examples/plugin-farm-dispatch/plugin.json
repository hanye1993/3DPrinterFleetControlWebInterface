{
  "identifier": "farm_dispatch",
  "name": "巡查派单",
  "version": "1.0.13",
  "description": "巡查看板卡片网格展示；按设备分组筛选；ACL 仅显示授权机器；智能派单。",
  "copyright": "hanye",
  "author": "hanye",
  "available": true,
  "hooks": [
    "register",
    "control_before",
    "print_batch_before",
    "print_start",
    "print_request_create",
    "statuses_publish",
    "ui_assets",
    "permissions_catalog"
  ],
  "modules": [
    {
      "name": "patrol",
      "menu": "巡查看板",
      "type": "page",
      "displayOrder": 38,
      "perm": "plugin.farm_dispatch.patrol"
    },
    {
      "name": "audit",
      "menu": "派单审核",
      "type": "page",
      "displayOrder": 39,
      "perm": "plugin.farm_dispatch.audit"
    },
    {
      "name": "submit",
      "menu": "提交打印",
      "type": "page",
      "displayOrder": 40,
      "perm": "plugin.farm_dispatch.submit"
    },
    {
      "name": "logs",
      "menu": "派单日志",
      "type": "page",
      "displayOrder": 42,
      "perm": "plugin.farm_dispatch.logs"
    }
  ],
  "vars": [
    {
      "key": "block_unavailable",
      "title": "拦截不可用设备开打（维修/报错/完成未确认/打印中/离线/未绑耗材）",
      "type": "boolean",
      "value": "1"
    },
    {
      "key": "require_filament",
      "title": "智能派单要求设备已绑定耗材",
      "type": "boolean",
      "value": "1"
    },
    {
      "key": "max_file_mb",
      "title": "申请上传 G-code 最大 MB",
      "type": "number",
      "value": "80"
    },
    {
      "key": "log_max",
      "title": "操作日志最多保留条数",
      "type": "number",
      "value": "5000"
    }
  ],
  "clientJs": ["client.js"],
  "themeCss": "theme.css",
  "mainFile": "main.js",
  "installFile": "install.js",
  "uninstallFile": "uninstall.js",
  "compatibleSoftwares": ["hanye-printer-monitor"]
}
