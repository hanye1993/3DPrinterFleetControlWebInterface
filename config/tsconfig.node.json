{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "../src",
    "outDir": "../dist/node-check",
    "types": ["node"]
  },
  "include": ["../src/main/**/*", "../src/shared/**/*"]
}
