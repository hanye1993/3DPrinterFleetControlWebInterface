# Dependencies
node_modules/

# Build
dist/
out/
out-server/
*.tsbuildinfo

# Local packaged plugin/theme zips (do not publish)
dist-plugins-cn/
dist-plugins/
*.zip

# Logs & env
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
*.local

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# OS
Desktop.ini

# Local runtime data (devices, users, installed plugins/themes, secrets)
/data/*
!/data/.gitkeep
/userdata/
/downloads/
/secrets.bin
*.bin

# Never ship local secrets under assets/plugins
/assets/plugins/*
!/assets/plugins/.gitkeep
!/assets/plugins/.env.example

# Plugin examples/source — distribute as zip only, not in git
/assets/examples/plugin-*/

# 应用市场为独立项目，不随控制台仓库发布
/应用市场/

# Plugin runtime JSON under assets (local only)
/assets/data/

# Local-only (可删：本机临时 Node/npm)
.tools/
.transcript-extract/
.cursor/

# 本机应急关扩展页（Discuz 风格），勿提交/勿上传
/close_extensions.mjs
/close_extensions.html

# 安装包统一输出目录（勿提交；一键包不上传三端 Release）
/packages/*
!/packages/.gitkeep

# 各平台安装包源码在 packages-src/（跟踪源码；忽略构建缓存）
/packages-src/**/cache/
/packages-src/win/staging/
/packages-src/win/installer-go/staging.zip
/packages-src/mac/staging-*/
/packages-src/mac/dmg-*/
/packages-src/linux/staging-*/
/packages-src/linux/nfpm-work-*/
/packages-src/fnos/**/app/server/
/packages-src/fnos/**/app/docker/
/packages-src/fnos/**/*.fpk
/packages-src/syno/**/server/
/packages-src/syno/**/*.spk

*.fpk
*.spk
*.exe
*.dmg
*.deb
*.rpm
